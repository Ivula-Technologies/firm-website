# Form emails (contact, proposal and newsletter forms) are sent with Resend.
# Without these, forms show the email and WhatsApp details instead of failing silently.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "JENIQA Website <website@jeniqa.com>"
RESEND_FROM=
# Where enquiries go (comma-separated for several)
ENQUIRY_TO=info@jeniqa.com
# Public address of the site, used in links, the sitemap and share previews
NEXT_PUBLIC_SITE_URL=https://www.jeniqa.com
